<%% if @scalar_test_auth_enabled %>
  <details id="scalar-test-auth"<%%= " open" if @scalar_test_auth_open %>>
    <summary>Test authentication</summary>

    <%% if @scalar_test_error.present? %><p role="alert"><%%= @scalar_test_error %></p><%% end %>
    <%% if @scalar_test_notice.present? %><p><%%= @scalar_test_notice %></p><%% end %>

    <%% if @scalar_test_access_points.any? %>
      <%%= form_with url: <%= credential_route_helper %>(version: @scalar_test_auth_version), method: :post, local: true do |form| %>
        <%%= form.label :access_point_recording_id, "Access point" %>
        <%%= form.select :access_point_recording_id, options_for_select(@scalar_test_access_points.map { |entry| [entry.fetch(:label), entry.fetch(:id)] }, @scalar_test_selected_access_point_id) %>
        <%%= form.label :role, "Role" %>
        <%%= form.select :role, options_for_select(@scalar_test_roles.map { |role| [role.humanize, role] }, @scalar_test_token&.fetch("role", "admin") || "admin") %>
        <%%= form.submit "Generate token" %>
      <%% end %>
    <%% else %>
      <p>No manageable API scope is available.</p>
    <%% end %>

    <%% if @scalar_test_token.present? %>
      <p>Paste this bearer value into Scalar:</p>
      <pre>Bearer <%%= @scalar_test_token.fetch("access_token") %></pre>
      <%%= button_to "Revoke token", <%= credential_route_helper %>(version: @scalar_test_auth_version), method: :delete %>

      <dl>
        <%% @scalar_test_context_rows.each do |row| %>
          <dt><%%= row.fetch(:field) %></dt>
          <dd><%%= row.fetch(:value) %></dd>
        <%% end %>
      </dl>

      <table>
        <thead><tr><th>Resource</th><th>Label</th><th>ID</th></tr></thead>
        <tbody>
          <%% @scalar_test_sample_rows.each do |row| %>
            <tr><td><%%= row.fetch(:resource) %></td><td><%%= row.fetch(:label) %></td><td><%%= row.fetch(:id) %></td></tr>
          <%% end %>
        </tbody>
      </table>
    <%% end %>
  </details>
<%% end %>