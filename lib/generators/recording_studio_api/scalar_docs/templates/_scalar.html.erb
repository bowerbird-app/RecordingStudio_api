<div id="scalar-api-reference" style="min-height: 100vh;">Loading API documentation...</div>
<script id="scalar-api-reference-source" src="<%= ERB::Util.html_escape(scalar_source) %>"<% if scalar_integrity.present? %> integrity="<%= ERB::Util.html_escape(scalar_integrity) %>" crossorigin="anonymous"<% end %> defer></script>
<script>
  (function () {
    function scalarTarget() {
      return document.getElementById("scalar-api-reference");
    }

    function initializeScalar() {
      var target = scalarTarget();
      if (!target || target.dataset.scalarInitialized === "true") return;
      if (!window.Scalar || typeof window.Scalar.createApiReference !== "function") {
        displayScalarLoadFailure();
        return;
      }

      try {
        target.textContent = "";
        window.Scalar.createApiReference("#scalar-api-reference", <%%= raw @scalar_configuration_json %>);
        target.dataset.scalarInitialized = "true";
      } catch (error) {
        displayScalarLoadFailure();
      }
    }

    function displayScalarLoadFailure() {
      var target = scalarTarget();
      if (target && target.dataset.scalarInitialized !== "true") {
        target.textContent = "Unable to load Scalar API documentation. Verify the configured Scalar source.";
      }
    }

    var source = document.getElementById("scalar-api-reference-source");
    source.addEventListener("load", initializeScalar, { once: true });
    source.addEventListener("error", displayScalarLoadFailure, { once: true });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeScalar, { once: true });
    } else {
      initializeScalar();
    }

    window.addEventListener("load", function () {
      initializeScalar();
    }, { once: true });
  }());
</script>
