<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <div class="space-y-6">
    <% recording_studio_page_nav(title: "Could not connect") %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "Could not connect",
      variant: :h1
    ) %>

    <%= render FlatPack::Alert::Component.new(
      description: @oauth_error.fetch(:error_description),
      style: :danger
    ) %>
  </div>
<% end %>
