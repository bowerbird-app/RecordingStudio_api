<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(
    anchor_url: page_nav_close_url
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Tokens",
    subtitle: @api_client.name,
    variant: :h1
  ) %>

  <p class="text-sm text-slate-600">
    A token is a temporary pass that lets this API key make requests.
  </p>

  <% if @token_rows.any? %>
    <%= render FlatPack::Table::Component.new(data: @token_rows) do |table| %>
      <% table.column(title: "Prefix", html: ->(row) { row.fetch(:prefix) }) %>
      <% table.column(title: "Status", html: ->(row) { row.fetch(:status) }) %>
      <% table.column(title: "Expires", html: lambda { |row|
           render FlatPack::Timestamp::Component.new(timestamp: row.fetch(:expires_at), fallback_text: "Never")
         }) %>
      <% table.column(title: "Last used", html: lambda { |row|
           render FlatPack::Timestamp::Component.new(timestamp: row.fetch(:last_used_at), fallback_text: "Never")
         }) %>
      <% table.column(title: "Issued", html: lambda { |row|
           render FlatPack::Timestamp::Component.new(timestamp: row.fetch(:issued_at), fallback_text: "-")
         }) %>
      <% table.column(title: "Actions", html: ->(row) { row.fetch(:actions) }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No tokens yet",
      description: "This API client has not issued any access tokens yet.",
      icon: :inbox
    ) %>
  <% end %>
</div>
