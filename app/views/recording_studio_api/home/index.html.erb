<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: "RecordingStudio API",
    subtitle: "Renamed engine shell and architecture handoff for programmable Recording Studio access.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Namespace renamed", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Dummy docs updated", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "API design captured", style: :warning, size: :sm) %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Completion status",
          subtitle: "What this repository now delivers after finishing the previous agent's work.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <%= render FlatPack::List::Item.new(icon: :queue_list) do %>
            <span>The gem, engine, generators, migrations, and tests now use the <code>RecordingStudioApi</code> namespace.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :eye) do %>
            <span>The dummy app now presents RecordingStudio API-specific install, config, and method documentation.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :folder) do %>
            <span>The preserved template reference docs remain isolated under <code>docs/gem_template/</code>.</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Planned HTTP architecture",
          subtitle: "The original design deliverables now captured in the repo.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <%= render FlatPack::List::Item.new(icon: :settings) do %>
            <span>Expose explicit API surface, resource, nested-resource, and action registries.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :lock) do %>
            <span>Map actions to Recording Studio capabilities and validate those mappings at boot.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :queue_list) do %>
            <span>Keep route nesting aligned with the real recording tree.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :code_bracket) do %>
            <span>Use serializers and handlers as explicit per-action contracts.</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Access model",
          subtitle: "How the future API surface should authenticate and authorize requests.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <%= render FlatPack::List::Item.new(icon: :eye) do %>
            <span><code>ApiClient</code> acts as the API principal beneath an accessible record.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :lock) do %>
            <span>Each accessible record should own at most one active API credential record.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :settings) do %>
            <span>Authorization should remain delegated to accessible records and Recording Studio access boundaries.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :folder) do %>
            <span>Secrets should only be revealed at create or rotate time.</span>
          <% end %>
        <% end %>
      <% end %>

      <% card.footer do %>
        <%= link_to "View FlatPack documentation",
                    "https://github.com/bowerbird-app/flatpack",
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(
            text: "View FlatPack documentation",
            style: :primary,
            size: :md
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Host-app workflow",
          subtitle: "The practical path that the renamed engine supports today.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <%= render FlatPack::List::Item.new(icon: :arrow_down_tray) do %>
            <span>Install the gem and run <code>rails generate recording_studio_api:install</code>.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :folder) do %>
            <span>Copy the sample migration with <code>rails generate recording_studio_api:migrations</code>.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :eye) do %>
            <span>Use the dummy app docs pages to review config, install, and method expectations.</span>
          <% end %>
          <%= render FlatPack::List::Item.new(icon: :home) do %>
            <span>Implement the HTTP API layer as a follow-up on top of the renamed engine shell.</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
