<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @admin_api.name,
    subtitle: "Gem-provided starting point for admin API tooling under the current admin root.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Settings",
      style: :default,
      size: :md,
      url: RecordingStudioApi.admin_settings_path(controller: self, close_url: request.fullpath)
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: "Rate limiting",
      style: :default,
      size: :md,
      url: RecordingStudioApi.admin_rate_limiting_path(controller: self, close_url: request.fullpath)
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: "Logs",
      style: :default,
      size: :md,
      url: RecordingStudioApi.admin_logs_path(controller: self, close_url: request.fullpath)
    ) %>
  </div>

  <%= render FlatPack::Grid::Component.new(cols: 2, class: "items-start gap-6") do %>
    <%= render FlatPack::Card::Component.new(style: :default, class: "h-full") do %>
      <div class="flex h-full flex-col gap-4">
        <div class="flex items-start justify-between gap-4">
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Last 24 hours",
            subtitle: "API requests",
            class: "my-0"
          ) %>

          <%= render FlatPack::Button::Component.new(
            text: "Full screen",
            style: :default,
            size: :sm,
            url: @last_24_hours_requests_path
          ) %>
        </div>

        <%= render FlatPack::Chart::Component.new(
          card: false,
          type: :line,
          height: 260,
          series: [
            { name: "API requests", data: @log_chart_series }
          ],
          options: {
            stroke: {
              curve: "smooth",
              width: 3
            },
            xaxis: {
              categories: @log_chart_categories,
              labels: {
                rotate: 0,
                hideOverlappingLabels: true
              }
            },
            yaxis: {
              min: 0,
              forceNiceScale: true
            },
            dataLabels: {
              enabled: false
            }
          }
        ) %>
      </div>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default, class: "h-full") do %>
      <div class="flex h-full flex-col gap-4">
        <div class="flex items-start justify-between gap-4">
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Last 30 days",
            subtitle: "API requests",
            class: "my-0"
          ) %>

          <%= render FlatPack::Button::Component.new(
            text: "Full screen",
            style: :default,
            size: :sm,
            url: @last_30_days_requests_path
          ) %>
        </div>

        <%= render FlatPack::Chart::Component.new(
          card: false,
          type: :line,
          height: 260,
          series: [
            { name: "API requests", data: @log_chart_series_last_30_days }
          ],
          options: {
            stroke: {
              curve: "smooth",
              width: 3
            },
            xaxis: {
              categories: @log_chart_categories_last_30_days,
              labels: {
                rotate: 0,
                hideOverlappingLabels: true
              }
            },
            yaxis: {
              min: 0,
              forceNiceScale: true
            },
            dataLabels: {
              enabled: false
            }
          }
        ) %>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default, class: "h-full") do %>
    <div class="flex h-full flex-col gap-4">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Rate limiting (last 30 days)",
        subtitle: "Rate-limited requests per day",
        class: "my-0"
      ) %>

      <%= render FlatPack::Chart::Component.new(
        card: false,
        type: :line,
        height: 260,
        series: [
          { name: "Rate-limited requests", data: @rate_limited_chart_series_last_30_days }
        ],
        options: {
          stroke: {
            curve: "smooth",
            width: 3
          },
          xaxis: {
            categories: @rate_limited_chart_categories_last_30_days,
            labels: {
              rotate: 0,
              hideOverlappingLabels: true
            }
          },
          yaxis: {
            min: 0,
            forceNiceScale: true
          },
          dataLabels: {
            enabled: false
          }
        }
      ) %>
    </div>
  <% end %>
</div>