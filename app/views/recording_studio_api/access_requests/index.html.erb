<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 pb-6">
  <%= render FlatPack::PageNav::Component.new(
    anchor_url: page_nav_close_url
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "API keys",
    subtitle: @access_list_subtitle,
    variant: :h1
  ) %>

  <% if @can_manage_access_requests %>
    <div>
      <%= render FlatPack::Button::Component.new(
        text: "New",
        style: :primary,
        size: :md,
        url: new_api_client_path(page_nav_close_param)
      ) %>
    </div>

    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md, align: :stretch) do %>
      <%= render FlatPack::Card::Component.new(style: :default) do %>
        <div class="space-y-4">
          <%= render FlatPack::SectionTitle::Component.new(
            title: "API keys",
            subtitle: "Most used keys"
          ) %>

          <% if @most_used_api_keys.present? %>
            <div id="most-used-api-keys">
              <%= render FlatPack::List::Component.new(divider: true) do %>
                <% @most_used_api_keys.each do |api_key_row| %>
                  <%= render FlatPack::List::Item.new(icon: :key) do %>
                    <div class="flex items-center justify-between gap-3">
                      <p class="text-sm font-medium text-(--surface-content-color)"><%= api_key_row.fetch(:name) %></p>
                      <p class="text-xs text-(--surface-content-subtle-color)"><%= pluralize(api_key_row.fetch(:request_count), "request") %></p>
                    </div>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-(--surface-content-subtle-color)">No API keys yet.</p>
          <% end %>
        </div>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do %>
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-3">
            <%= render FlatPack::SectionTitle::Component.new(
              title: "API requests",
              subtitle: "Last 7 days"
            ) %>

            <%= render FlatPack::Button::Component.new(
              text: "Full screen",
              style: :default,
              size: :sm,
              url: requests_chart_api_clients_path(requests_chart_link_params)
            ) %>
          </div>

          <%= render FlatPack::Chart::Component.new(
            card: false,
            type: :bar,
            height: 220,
            series: [
              { name: "API requests", data: @requests_chart_series }
            ],
            options: {
              grid: {
                show: false
              },
              xaxis: {
                categories: @requests_chart_categories,
                labels: { show: false },
                axisBorder: { show: false },
                axisTicks: { show: false }
              },
              yaxis: {
                show: false
              }
            }
          ) %>
        </div>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <%= card.body do %>
          <div class="flex items-center gap-4">
            <div class="shrink-0 w-12 h-12 rounded-xl bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] flex items-center justify-center">
              <%= render FlatPack::Shared::IconComponent.new(name: "key", size: :lg, class: "text-[var(--surface-muted-content-color)]") %>
            </div>

            <div class="flex flex-col">
              <span class="text-xs font-medium text-[var(--surface-muted-content-color)] uppercase tracking-wide">Total API keys</span>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="text-2xl font-bold text-[var(--surface-content-color)]"><%= number_with_delimiter(@total_api_keys || 0) %></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @api_access_rows.any? %>
    <%= render partial: "table_content" %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No API access given yet",
      description: @can_manage_access_requests ? "Create API access from the demo home page to populate this list." : "You can view API access details, but you do not have permission to create new API access.",
      icon: :inbox
    ) %>
  <% end %>
</div>
