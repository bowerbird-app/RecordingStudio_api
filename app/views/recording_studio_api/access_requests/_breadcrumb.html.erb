<% back_href = local_assigns[:anchor_url].presence || local_assigns.fetch(:back_fallback_url, main_app.root_path) %>

<nav class="flat-pack-breadcrumb" aria-label="Breadcrumb">
  <ol class="flex items-center gap-2 text-sm">
    <li class="inline-flex items-center gap-1">
      <%= link_to back_href, class: "inline-flex items-center gap-1 text-(--surface-content-color) underline decoration-(--surface-border-color) underline-offset-2 hover:decoration-(--surface-content-color)" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span>Back</span>
      <% end %>
    </li>
    <li aria-hidden="true" class="text-(--surface-muted-content-color)">/</li>
    <li class="inline-flex items-center gap-1">
      <%= link_to main_app.root_path, class: "inline-flex items-center gap-1 text-(--surface-content-color) underline decoration-(--surface-border-color) underline-offset-2 hover:decoration-(--surface-content-color)" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-6.75c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" />
        </svg>
        <span>Home</span>
      <% end %>
    </li>
  </ol>
</nav>
