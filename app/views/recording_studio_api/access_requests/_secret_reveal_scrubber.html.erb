<%= javascript_tag do %>
  (() => {
    const secret = document.querySelector("[data-secret-reveal-target='secret']");
    if (!secret) return;

    const scrubSecret = () => {
      secret.textContent = "Secret hidden after leaving this page.";
      secret.dataset.secretRevealed = "false";
    };

    window.addEventListener("pagehide", scrubSecret, { once: true });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) scrubSecret();
    });
    document.addEventListener("turbo:before-cache", scrubSecret, { once: true });
  })();
<% end %>