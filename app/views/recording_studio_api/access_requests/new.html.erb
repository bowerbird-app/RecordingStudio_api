<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <% recording_studio_page_nav(
    title: "Create API key",
    page_nav_anchor_url: page_nav_close_url
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Create API key",
    variant: :h1
  ) %>

  <% if @errors.any? %>
    <%= render FlatPack::Card::Component.new(style: :default) do %>
      <div class="space-y-2">
        <p class="text-sm font-medium text-red-700">The API client could not be created.</p>
        <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @errors.uniq.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: api_clients_path(page_nav_close_param), scope: :api_client, method: :post, class: "space-y-6" do |form| %>
    <%= form.hidden_field :root_type, value: @form_values.fetch(:root_type) %>

    <%= render FlatPack::TextInput::Component.new(
      name: "api_client[api_client_name]",
      value: @form_values.fetch(:api_client_name),
      label: "Name",
      class: "w-full"
    ) %>

    <%= render FlatPack::Select::Component.new(
      name: "api_client[access_point_recording_id]",
      options: @access_point_recordings.map { |recording| [recording_label(recording), recording.id] },
      value: @form_values.fetch(:access_point_recording_id),
      label: "Access point",
      class: "w-full"
    ) %>

    <%= render FlatPack::Select::Component.new(
      name: "api_client[role]",
      options: @role_options,
      value: @form_values.fetch(:role),
      label: "Role",
      class: "w-full"
    ) %>

    <p class="text-sm text-(--surface-muted-content-color)">This will determine the access level of the api key.</p>

    <%= render FlatPack::DateInput::Component.new(
      name: "api_client[expires_at]",
      value: @form_values.fetch(:expires_at),
      placeholder: "Never",
      label: "Expires (optional)",
      class: "w-full"
    ) %>

    <div class="flex flex-wrap gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Create",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    </div>
  <% end %>
</div>