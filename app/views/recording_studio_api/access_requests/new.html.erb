<div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <%= render "breadcrumb", anchor_url: main_app.root_path, back_fallback_url: main_app.root_path %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Add API access",
    variant: :h1
  ) %>

  <% if @errors.any? %>
    <%= render FlatPack::Card::Component.new(style: :default) do %>
      <div class="space-y-2">
        <p class="text-sm font-medium text-red-700">The API client could not be created.</p>
        <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @errors.uniq.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: api_clients_path, scope: :api_client, method: :post, class: "space-y-6" do |form| %>
    <%= form.hidden_field :root_type, value: @form_values.fetch(:root_type) %>

    <div class="space-y-2">
      <label for="api_client_api_client_name" class="block text-sm font-medium text-(--surface-content-color)">Name</label>
      <%= form.text_field :api_client_name,
        value: @form_values.fetch(:api_client_name),
        class: "flat-pack-input w-full rounded-md border bg-[var(--surface-background-color)] px-[var(--form-control-padding)] py-[var(--form-control-padding)] text-sm text-[var(--surface-content-color)] border-[var(--surface-border-color)]" %>
    </div>

    <div class="space-y-2">
      <label for="api_client_role" class="block text-sm font-medium text-(--surface-content-color)">Role</label>
      <%= form.select :role,
        options_for_select(@role_options, @form_values.fetch(:role)),
        {},
        class: "flat-pack-input w-full rounded-md border bg-[var(--surface-background-color)] px-[var(--form-control-padding)] py-[var(--form-control-padding)] text-sm text-[var(--surface-content-color)] border-[var(--surface-border-color)]" %>
    </div>

    <div class="space-y-2">
      <label for="api_client_expires_at" class="block text-sm font-medium text-(--surface-content-color)">Expires</label>
      <%= form.datetime_local_field :expires_at,
        value: @form_values.fetch(:expires_at),
        class: "flat-pack-input w-full rounded-md border bg-[var(--surface-background-color)] px-[var(--form-control-padding)] py-[var(--form-control-padding)] text-sm text-[var(--surface-content-color)] border-[var(--surface-border-color)]" %>
      <p class="text-sm text-(--surface-muted-content-color)">Leave blank to use the configured token TTL.</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Create access",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>

      <%= button_to "Cancel", main_app.root_path, method: :get, class: "inline-flex items-center justify-center gap-2 rounded-[var(--button-border-radius)] font-medium cursor-pointer transition-colors duration-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--button-focus-ring-color)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--button-focus-ring-offset-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm bg-[var(--surface-background-color)] text-[var(--surface-content-color)] border border-[var(--surface-border-color)]" %>
    </div>
  <% end %>
</div>