<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <% flat_pack_page_nav(round: true, style: :default, anchor_href: page_nav_close_url, anchor_tooltip: "Close") %>

  <% content_for :title, "Copy secret" %>
  <% content_for :subtitle, "This is only shown once. Use it to access the API." %>

  <pre class="overflow-x-auto rounded-md border border-(--surface-border-color) bg-(--surface-background-color) p-4 text-sm text-(--surface-content-color)" data-secret-reveal-target="secret"><%= @payload.fetch(:token) %></pre>

  <%= render "recording_studio_api/access_requests/secret_reveal_scrubber" %>

  <div class="flex flex-wrap gap-3">
    <% finish_url = page_nav_close_url == main_app.root_path ? "/api/screens/api_keys" : page_nav_close_url %>
    <%= button_to "Finish", finish_url, method: :get, class: "inline-flex items-center justify-center gap-2 rounded-[var(--button-border-radius)] font-medium cursor-pointer transition-colors duration-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--button-focus-ring-color)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--button-focus-ring-offset-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm bg-[var(--button-primary-background-color)] text-[var(--button-primary-text-color)] border border-[var(--button-primary-border-color)] shadow-[var(--button-shadow)]" %>
  </div>
</div>