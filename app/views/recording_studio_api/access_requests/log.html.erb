<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(
    entries: [
      { label: "Back", url: api_client_path(@api_client, page_nav_close_param), icon: :arrow_left }
    ],
    anchor_url: page_nav_close_url
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: @api_client.name,
    subtitle: "API request log",
    variant: :h1
  ) %>

  <% status_badge = lambda do |row|
       status_text = row.fetch(:status).to_s
       status_code = Integer(status_text, exception: false)

       style = case status_code
               when 200..299 then :success
               when 300..399 then :info
               when 400..499 then :warning
               when 500..599 then :primary
               else :default
               end

       render FlatPack::Badge::Component.new(
         text: status_text,
         style: style,
         size: :sm
       )
     end %>

  <% if @log_rows.any? %>
    <%= render FlatPack::Table::Component.new(data: @log_rows) do |table| %>
      <% table.column(title: "Occurred", html: lambda { |row|
           render FlatPack::Timestamp::Component.new(timestamp: row.fetch(:occurred_at), fallback_text: "-")
         }) %>
      <% table.column(title: "Method", html: ->(row) { row.fetch(:method) }) %>
      <% table.column(title: "Path", html: ->(row) { row.fetch(:path) }) %>
      <% table.column(title: "Status", html: status_badge) %>
      <% table.column(title: "Duration", html: ->(row) { row.fetch(:duration) }) %>
      <% table.column(title: "Request ID", html: ->(row) { row.fetch(:request_id) }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No API logs yet",
      description: "This API client has not made any logged API requests yet.",
      icon: :inbox
    ) %>
  <% end %>
</div>
