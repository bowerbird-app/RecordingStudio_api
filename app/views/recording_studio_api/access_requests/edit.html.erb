<div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <%= render "breadcrumb", anchor_url: access_request_path(@api_client), back_fallback_url: access_request_path(@api_client) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit API access",
    subtitle: "Update the API name, role, and credential expiry for this access entry.",
    variant: :h1
  ) %>

  <% if @errors.any? %>
    <%= render FlatPack::Card::Component.new(style: :default) do %>
      <div class="space-y-2">
        <p class="text-sm font-medium text-red-700">The request could not be updated.</p>
        <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @errors.uniq.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: access_request_path(@api_client), scope: :access_request, method: :patch, class: "space-y-6" do |form| %>
    <div class="space-y-2">
      <label for="access_request_api_client_name" class="block text-sm font-medium text-[var(--surface-content-color)]">Name</label>
      <%= form.text_field :api_client_name,
        value: @form_values.fetch(:api_client_name),
        class: "flat-pack-input w-full rounded-md border bg-[var(--surface-background-color)] px-[var(--form-control-padding)] py-[var(--form-control-padding)] text-sm text-[var(--surface-content-color)] border-[var(--surface-border-color)]" %>
    </div>

    <div class="space-y-2">
      <label for="access_request_role" class="block text-sm font-medium text-[var(--surface-content-color)]">Role</label>
      <%= form.select :role,
        options_for_select(@role_options, @form_values.fetch(:role)),
        {},
        class: "flat-pack-input w-full rounded-md border bg-[var(--surface-background-color)] px-[var(--form-control-padding)] py-[var(--form-control-padding)] text-sm text-[var(--surface-content-color)] border-[var(--surface-border-color)]" %>
    </div>

    <div class="space-y-2">
      <label for="access_request_expires_at" class="block text-sm font-medium text-[var(--surface-content-color)]">Expires</label>
      <%= form.datetime_local_field :expires_at,
        value: @form_values.fetch(:expires_at),
        class: "flat-pack-input w-full rounded-md border bg-[var(--surface-background-color)] px-[var(--form-control-padding)] py-[var(--form-control-padding)] text-sm text-[var(--surface-content-color)] border-[var(--surface-border-color)]" %>
      <p class="text-sm text-(--surface-muted-content-color)">Leave blank to remove expiry from the latest credential.</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Save changes",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    </div>
  <% end %>
</div>
