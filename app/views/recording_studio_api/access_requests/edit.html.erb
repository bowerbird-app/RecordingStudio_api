<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <% content_for :title, "Edit API key" %>
  <% flat_pack_page_nav(round: true, style: :default, anchor_href: page_nav_close_url, anchor_tooltip: "Close") %>
  <% if @latest_credential&.revoked_at.nil? %>
    <% register_page_nav "Rotate key", rotate_api_client_path(@api_client, page_nav_close_param), role: :secondary, aria: {label: "Create a new secret and api key"}, data: { turbo_method: :post, turbo_confirm: "Rotate this API key? This will revoke the current key." } %>
    <% register_page_nav "Revoke", revoke_api_client_path(@api_client, page_nav_close_param), role: :destructive, data: { turbo_method: :post, turbo_confirm: "Revoke this API key?" } %>
  <% end %>

  <% if @errors.any? %>
    <%= render FlatPack::Card::Component.new(background: :default) do %>
      <div class="space-y-2">
        <p class="text-sm font-medium text-red-700">The API client could not be updated.</p>
        <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @errors.uniq.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: api_client_path(@api_client, page_nav_close_param), scope: :api_client, method: :patch, class: "space-y-6" do |form| %>
    <%= render 'form_fields',
      form: form,
      form_values: @form_values,
      api_options: @api_options,
      role_options: @role_options,
      access_point_recordings: @access_point_recordings,
      show_root_hidden: false,
      submit_text: "Save changes" %>
  <% end %>
</div>
