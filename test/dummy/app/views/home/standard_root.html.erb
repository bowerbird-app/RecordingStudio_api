<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio API demo",
    subtitle: "Demo to add and remove API access",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Workspace",
    subtitle: "Current child access recordings where workspace access has been provided."
  ) %>

  <div class="-mt-3 flex flex-wrap justify-start gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "API keys",
        style: :default,
        size: :md,
        url: recording_studio_api.api_clients_path(@workspace_api_keys_params)
      ) %>
  </div>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Folder",
    subtitle: "Current child access recordings where folder access has been provided."
  ) %>

  <div class="-mt-3 flex flex-wrap justify-start gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "API keys",
        style: :default,
        size: :md,
        url: recording_studio_api.api_clients_path(@folder_api_keys_params)
      ) %>
  </div>

</div>