<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio API demo",
    subtitle: "Demo to add and remove API access",
    variant: :h1
  ) %>

  <div class="-mt-3 flex flex-wrap justify-start gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "API settings",
      style: :default,
      size: :md,
      href: @api_admin_path
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: "API docs",
      style: :default,
      size: :md,
      href: "/docs/scalar"
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: "Create API test token",
      style: :default,
      size: :md,
      href: public_api_scalar_test_credential_path(version: RecordingStudioApi.default_api_version)
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: "Connected apps",
      style: :default,
      size: :md,
      href: connected_apps_path
    ) %>
  </div>

</div>