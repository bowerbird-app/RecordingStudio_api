<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio API demo",
    subtitle: "Demo to add and remove API access",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Workspace",
    subtitle: "Current child access recordings where workspace access has been provided."
  ) %>

  <div class="-mt-3 flex flex-wrap justify-start gap-3">
      <%= button_to "API keys", recording_studio_api.api_clients_path(root_type: "Workspace", include_children: "1", close_url: root_path), method: :get, class: "inline-flex items-center justify-center gap-2 rounded-[var(--button-border-radius)] font-medium cursor-pointer transition-colors duration-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--button-focus-ring-color)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--button-focus-ring-offset-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm bg-[var(--surface-background-color)] text-[var(--surface-content-color)] border border-[var(--surface-border-color)]" %>
  </div>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Folder",
    subtitle: "Current child access recordings where folder access has been provided."
  ) %>

  <div class="-mt-3 flex flex-wrap justify-start gap-3">
      <%= button_to "API keys", recording_studio_api.api_clients_path(root_type: "Folder", include_children: "1", close_url: root_path), method: :get, class: "inline-flex items-center justify-center gap-2 rounded-[var(--button-border-radius)] font-medium cursor-pointer transition-colors duration-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--button-focus-ring-color)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--button-focus-ring-offset-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm bg-[var(--surface-background-color)] text-[var(--surface-content-color)] border border-[var(--surface-border-color)]" %>
  </div>

</div>