<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "RecordingStudio API",
      subtitle: "Host app guide"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Home",
        href: main_app.root_path,
        icon: :home
      ) %>

      <% if admin_root_current? %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Admin API",
          href: "/admin/api",
          icon: :queue_list
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Operations credentials",
          href: main_app.recording_studio_admin_admin_operations_api_path,
          icon: :key
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Operations API docs",
          href: main_app.operations_api_scalar_docs_path,
          icon: :document_text
        ) %>
      <% else %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Install",
          href: main_app.docs_install_path,
          icon: :arrow_down_tray
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Config",
          href: main_app.docs_config_path,
          icon: :settings
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Add API capability",
          href: main_app.docs_add_capability_path,
          icon: :plus
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Gem Views",
          href: main_app.docs_gem_views_path,
          icon: :eye
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "API routes",
          href: main_app.docs_api_routes_path,
          icon: :link
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Scalar",
          href: main_app.public_api_scalar_docs_path,
          icon: :document_text
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Auth",
          href: main_app.docs_auth_path,
          icon: :lock
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Methods",
          href: main_app.docs_methods_path,
          icon: :code_bracket
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Versions",
          href: main_app.docs_versions_path,
          icon: :rectangle_group
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "API hierarchy",
          href: main_app.docs_api_hierarchy_path,
          icon: :folder_open
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Recordings tree",
          href: main_app.docs_recordings_tree_path,
          icon: :folder
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Recordable types",
          href: main_app.docs_recordable_types_path,
          icon: :queue_list
        ) %>
      <% end %>

    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
