<%= render FlatPack::List::Item.new(icon: :folder) do %>
  <div class="flex flex-col gap-2">
    <span><%= node[:label] %></span>

    <% if node[:children].any? %>
      <div class="pl-4">
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <%= render partial: "recording_tree_node", collection: node[:children], as: :node %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
