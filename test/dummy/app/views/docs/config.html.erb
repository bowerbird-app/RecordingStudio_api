<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "How this gem loads and merges configuration.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioApi.configure do |config|
        config.timeout = 10
        config.token_ttl = 45.days
        config.api_versions = %w[v1 v2]
        config.default_api_version = "v2"

        config.version "v1" do |api|
          api.use :moveable, "~> 1.23"
        end

        config.version "v2" do |api|
          api.use :moveable, "~> 2.0"
        end

        # Optional Redis-backed throttling
        config.rate_limit_oauth_enabled = true
        config.rate_limit_api_pre_auth_enabled = true
        config.rate_limit_api_enabled = true
        config.rate_limit_redis_url = ENV["RECORDING_STUDIO_API_RATE_LIMIT_REDIS_URL"]
        config.rate_limit_oauth_requests = 10
        config.rate_limit_oauth_period_seconds = 60
        config.rate_limit_api_pre_auth_requests = 300
        config.rate_limit_api_pre_auth_period_seconds = 60
        config.rate_limit_api_read_requests = 120
        config.rate_limit_api_read_period_seconds = 60
        config.rate_limit_api_write_requests = 30
        config.rate_limit_api_write_period_seconds = 60

        # Optional: log API requests to the API request log database
        config.api_request_logging_enabled = true
        config.api_request_logging_payload_mode = "metadata_only"

        config.hooks.on_configuration do |loaded_config|
          Rails.logger.info("RecordingStudioApi timeout=#{loaded_config.timeout}")
        end
      end
    CODE
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <%= render FlatPack::List::Item.new(icon: :queue_list) do %>
        <span><code>config.api_versions</code> and <code>config.default_api_version</code> define the public API versions your app exposes.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :adjustments_horizontal) do %>
        <span><code>config.version</code> profiles map each public API version to compatible addon contribution contracts with <code>api.use</code>.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :sparkles) do %>
        <span>Constraint matching uses <code>Gem::Requirement</code>, while contribution versions are validated with <code>Gem::Version</code>.</span>
      <% end %>
    <% end %>
  <% end %>
</div>
