<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "How this gem loads and merges configuration.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioApi.configure do |config|
        config.enable_feature_x = false
        config.timeout = 10
        config.token_ttl = 45.days

        config.hooks.on_configuration do |loaded_config|
          Rails.logger.info("RecordingStudioApi timeout=#{loaded_config.timeout}")
        end
      end
    CODE
  ) %>

  <%= render FlatPack::List::Component.new(divider: true) do %>
    <%= render FlatPack::List::Item.new(icon: :settings) do %>
      <span>Defaults come from <code>RecordingStudioApi::Configuration</code>: <code>enable_feature_x</code>, <code>timeout</code>, <code>token_ttl</code>, <code>hooks</code>, and <code>action_registry</code>.</span>
    <% end %>
    <%= render FlatPack::List::Item.new(icon: :folder_open) do %>
      <span>At boot, the engine also merges <code>config/recording_studio_api.yml</code> and <code>config.x.recording_studio_api</code> when present.</span>
    <% end %>
    <%= render FlatPack::List::Item.new(icon: :link) do %>
      <span>Capability action registration is documented on the API and Methods pages so this page can stay configuration-focused.</span>
    <% end %>
  <% end %>
</div>
