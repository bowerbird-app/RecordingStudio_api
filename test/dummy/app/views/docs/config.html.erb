<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Current config keys plus the constraints for the future HTTP API registries.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioApi.configure do |config|
        # Optional placeholder for an outbound API integration you add later.
        # config.api_key = ENV["RECORDING_STUDIO_API_KEY"]
        config.enable_feature_x = false
        config.timeout = 5
      end
    CODE
  ) %>

  <%= render FlatPack::List::Component.new(divider: true) do %>
    <%= render FlatPack::List::Item.new(icon: :key) do %>
      <span><code>api_key</code> is currently just stored on the configuration object. The engine does not use it unless the host app adds an external integration that needs one.</span>
    <% end %>
    <%= render FlatPack::List::Item.new(icon: :settings) do %>
      <span>Future API surfaces should be registered explicitly rather than inferred from Ruby constants.</span>
    <% end %>
    <%= render FlatPack::List::Item.new(icon: :queue_list) do %>
      <span>Nested resource declarations should mirror the recording tree so route semantics stay consistent.</span>
    <% end %>
    <%= render FlatPack::List::Item.new(icon: :lock) do %>
      <span>Boot should fail fast when an action points at a capability that is not enabled for the target recordable type.</span>
    <% end %>
  <% end %>
</div>
