<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recordable types",
    subtitle: "Distinct recordable types currently present in RecordingStudio::Recording.",
    variant: :h1
  ) %>

  <% if @recordable_types.any? %>
    <%= render FlatPack::Table::Component.new(data: @recordable_types) do |table| %>
      <% table.column(title: "Type", html: ->(recordable_type) { recordable_type.fetch(:label) }) %>
      <% table.column(title: "Recordings", html: ->(recordable_type) { pluralize(recordable_type.fetch(:recordings_count), "recording") }) %>
      <% table.column(title: "Recordables", html: ->(recordable_type) { pluralize(recordable_type.fetch(:recordables_count), "recordable") }) %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">No recordings exist yet.</p>
  <% end %>
</div>