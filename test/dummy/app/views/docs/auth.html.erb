<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Auth",
    subtitle: "How OAuth2 client_credentials authentication works for RecordingStudioApi endpoints.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Token exchange",
    subtitle: "Exchange client credentials for a short-lived OAuth2 bearer access token.",
    anchor_link: true,
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      curl -X POST http://localhost:3000/recording_studio_api/oauth/token \
        -d grant_type=client_credentials \
        -d client_id=<client_id> \
        -d client_secret=<client_secret>
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Authorized request",
    subtitle: "Use the returned access token in the Authorization header for API requests.",
    anchor_link: true,
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      curl -H "Authorization: Bearer <access_token>" \
        http://localhost:3000/recording_studio_api/api/v1/workspaces
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Validation flow",
    subtitle: "Every API request runs through RecordingStudioApi::Concerns::BearerAuthentication.",
    anchor_link: true,
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <%= render FlatPack::List::Item.new(icon: :shield_check) do %>
        <span>The token endpoint calls <code>RecordingStudioApi::Services::IssueOauthAccessToken</code> and only accepts <code>grant_type=client_credentials</code>.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :key) do %>
        <span>API requests authenticate through <code>RecordingStudioApi::Services::AuthenticateOauthAccessToken</code> with <code>Authorization: Bearer &lt;access_token&gt;</code>.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :finger_print) do %>
        <span>The OAuth token service validates issued access token digests and confirms both token and underlying credential are active.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :folder_open) do %>
        <span>It resolves <code>access_recording</code>, <code>scope_recording</code>, and <code>root_recording</code>, rejecting trashed or invalid scope records.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :clock) do %>
        <span>On success, it updates <code>last_used_at</code> and exposes authenticated context to controllers.</span>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Authorization after authentication",
    subtitle: "Recording Studio access checks still run after token validation.",
    anchor_link: true,
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <%= render FlatPack::List::Item.new(icon: :check_badge) do %>
        <span>OAuth2 proves which API client is calling the endpoint.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :adjustments_horizontal) do %>
        <span>Then <code>RecordingStudioApi::AccessibleRecordingScope</code> applies Recording Studio visibility rules using <code>current_scope_recording</code> and <code>current_access_recording</code>.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :eye_slash) do %>
        <span>Resources outside the authenticated client's accessible tree remain hidden even with a valid token.</span>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Controller context",
    subtitle: "Values made available for API actions after successful auth.",
    anchor_link: true,
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      current_api_client
      current_api_credential
      current_access_recording
      current_scope_recording
      current_root_recording
    CODE
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <%= render FlatPack::List::Item.new(icon: :x_circle) do %>
        <span>Missing, malformed, inactive, or invalid tokens return <code>401 Unauthorized</code> with a JSON <code>error</code> message.</span>
      <% end %>
      <%= render FlatPack::List::Item.new(icon: :ban) do %>
        <span>Authorization failures during action execution return <code>403 Forbidden</code>.</span>
      <% end %>
    <% end %>
  <% end %>
</div>