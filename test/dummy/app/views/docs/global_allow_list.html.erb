<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Global allow list",
    subtitle: "Global resource-type allowlist used to decide which recordables are exposed as API resources.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "How it is enforced",
    subtitle: "The API resolves resource names against RecordingStudio.configuration.recordable_types.",
    anchor_link: true,
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # config/initializers/recording_studio.rb
      RecordingStudio.configure do |config|
        # Global resource-type allowlist
        config.recordable_types = ["Workspace", "Folder", "Page"]
      end

      # lib/recording_studio_api.rb
      module RecordingStudioApi
        class << self
          def api_recordable_types
            Array(RecordingStudio.configuration.recordable_types).map(&:to_s).uniq.reject do |recordable_type|
              recordable_type == "RecordingStudioApi::ApiClient"
            end
          end

          def recordable_type_for_resource(resource_name)
            api_recordable_types.find do |recordable_type|
              resource_name_for(recordable_type) == resource_name.to_s
            end
          end
        end
      end
    CODE
  ) %>

  <%= render FlatPack::List::Component.new(divider: true) do %>
    <%= render FlatPack::List::Item.new(icon: :check_badge) do %>
      <span>Only recordable types in <code>config.recordable_types</code> become API resources.</span>
    <% end %>
    <%= render FlatPack::List::Item.new(icon: :shield_check) do %>
      <span><code>RecordingStudioApi::ApiClient</code> is explicitly excluded from API resource exposure.</span>
    <% end %>
  <% end %>
</div>
